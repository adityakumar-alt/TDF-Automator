# Session Security (Required for JWT cookies)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Sheets Configuration
SPREADSHEET_ID=your_google_spreadsheet_id_here

# OAuth Redirect URI (Update with your actual Vercel project domain)
REDIRECT_URI=https://your-project.vercel.app/oauth2callback

# Saved OAuth Tokens (JSON string from ./oauth/tokens.json)
# Run in terminal to generate: node -e "console.log(JSON.stringify(require('./oauth/tokens.json')))"
GOOGLE_SAVED_TOKENS={"access_token":"...","refresh_token":"...","scope":"https://www.googleapis.com/auth/spreadsheets.readonly","token_type":"Bearer","expiry_date":1234567890}
